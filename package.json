{
  "name": "grenjo-ai-tool",
  "productName": "Grenjo AI Tool",
  "version": "0.2.0",
  "private": true,
  "description": "Grenjo AI Tool — a personal AI desktop application with bring-your-own-key providers, custom models, agents, attachments and optional cloud sync.",
  "author": "Grenjo AI Tool",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --config vitest.node.config.ts && vitest run --config vitest.renderer.config.ts",
    "test:unit": "vitest run --config vitest.node.config.ts",
    "test:ui": "vitest run --config vitest.renderer.config.ts",
    "test:watch": "vitest --config vitest.node.config.ts",
    "test:e2e": "playwright test",
    "serve:renderer": "node scripts/serve-renderer.mjs",
    "audit:gate": "node scripts/quality-gate.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run audit:gate && npm run typecheck && npm test && npm run build && npm run test:e2e && electron-builder --win nsis --config electron-builder.yml",
    "pack": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "dist:mac": "npm run audit:gate && npm run typecheck && npm test && npm run build && electron-builder --mac --config electron-builder.yml",
    "pack:mac": "npm run build && electron-builder --mac --dir --config electron-builder.yml"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "electron-updater": "6.8.11",
    "mammoth": "1.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "unpdf": "2.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
