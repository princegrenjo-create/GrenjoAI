# ---------------------------------------------------------------------------
# Personal AI Desk — example environment file
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. It is copied to `.env` by someone who
# wants to override defaults during development. Nothing here is required for the
# application to run, and no value from this file is ever bundled into the
# installer.
#
# API KEYS DO NOT BELONG IN THIS FILE.
# Provider keys are entered in the application UI and stored in the Windows
# credential store (DPAPI). They are never written to `.env`, SQLite, an export
# file, a log, or the repository. `.env*` and the credential file are gitignored.
# ---------------------------------------------------------------------------

# Log verbosity for the main process during development.
# One of: error | warn | info | debug   (default: debug in dev, info when packaged)
PERSONAL_AI_DESK_LOG_LEVEL=info

# Port for the Vite renderer dev server (must match vite.renderer.config.ts).
# Only used by `npm run dev`.
PERSONAL_AI_DESK_DEV_PORT=5273

# ---------------------------------------------------------------------------
# Cloud sync (optional)
#
# Sync is configured inside the app: Settings -> Cloud Sync, or Cloud Sync page.
# The Supabase URL is stored in the local settings table; the anon (publishable)
# key is stored in the Windows credential store. The values below are placeholders
# showing the expected SHAPE, and are not read by the application.
#
# NEVER put a service_role key anywhere in this project. It bypasses Row Level
# Security and would give anyone with the app full access to every row.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ---------------------------------------------------------------------------
# Deliberately absent
#
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
#
# These are intentionally not read from the environment. A desktop app that reads
# keys from env invites them into scripts, CI logs and screenshots. Add keys in
# the UI instead.
# ---------------------------------------------------------------------------
